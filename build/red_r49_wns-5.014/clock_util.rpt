# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y6 [get_cells u_pl/u_clk/u_bufg_fb]
set_property LOC BUFGCTRL_X0Y2 [get_cells u_pl/u_clk/u_bufg_5x]
set_property LOC BUFGCTRL_X0Y0 [get_cells u_pl/u_clk/u_bufg_pix]
set_property LOC BUFGCTRL_X0Y3 [get_cells u_idelay_clkgen/u_bufg_200]
set_property LOC BUFGCTRL_X0Y5 [get_cells u_idelay_clkgen/u_bufg_fb]
set_property LOC BUFGCTRL_X0Y1 [get_cells u_eth/u_rgmii/u_rgmii_rx/BUFG_inst]
set_property LOC BUFGCTRL_X0Y16 [get_cells u_bd/design_1_i/processing_system7_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG]
set_property LOC BUFGCTRL_X0Y4 [get_cells sys_clk_IBUF_BUFG_inst]

# Location of BUFIO Primitives 
set_property LOC BUFIO_X1Y3 [get_cells u_eth/u_rgmii/u_rgmii_rx/BUFIO_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X1Y35 [get_cells eth_tx_clk_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X1Y28 [get_ports eth_rxc]
set_property LOC IOB_X1Y24 [get_ports sys_clk]

# Clock net "u_pl/u_clk/clk_pix5x" driven by instance "u_pl/u_clk/u_bufg_5x" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_u_pl/u_clk/clk_pix5x}
add_cells_to_pblock [get_pblocks  {CLKAG_u_pl/u_clk/clk_pix5x}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_pl/u_clk/clk_pix5x"}]]]
resize_pblock [get_pblocks {CLKAG_u_pl/u_clk/clk_pix5x}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "u_pl/u_clk/clk_pix" driven by instance "u_pl/u_clk/u_bufg_pix" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_u_pl/u_clk/clk_pix}
add_cells_to_pblock [get_pblocks  {CLKAG_u_pl/u_clk/clk_pix}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_pl/u_clk/clk_pix"}]]]
resize_pblock [get_pblocks {CLKAG_u_pl/u_clk/clk_pix}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

