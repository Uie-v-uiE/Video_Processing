# 仿真 / 工具运行产物（第四版）
sim_work/
sim/xsim.dir/
sim/*.log
data/measured/ddr_dump.out
data/measured/ddr_dump.tcl
src/host/_xsdb_*.tcl

# 综合探针脚本跑出来的 Vivado 工程产物不入库
sim/probes/*.xpr
sim/probes/*.log
sim/probes/.Xil/
sim/probes/*.runs/
sim/probes/*.dcp
data/measured/health_*.out
sim/probes/*.cache/
sim/probes/*.hw/
sim/probes/*.runs/
sim/probes/*.log
sim/probes/*.jou
sim/probes/*_lastrun.log

# 构建产物快照（本地对照用，不入库：每个 .bit 约 10MB）
build/snap_*/
# 成套归档：只入库报告与 MANIFEST（md5 清单），二进制留在本地——与 ku5p/build/*.bit 同一条口径
build/frozen_*/*.bit
build/frozen_*/*.xsa
build/frozen_*/*.elf
build/failed_*/*.bit
build/failed_*/*.xsa

# KU5P 工程的 Vivado 生成目录（与 vivado_system/ 同理）
ku5p/vivado_ku5p/
ku5p/build/*.bit
clockInfo.txt

# 从 build/system.xsa 里解出来的 PS 初始化脚本（派生物，ps_jtag_boot.tcl 会自动重建）
build/ps7_init.tcl
build/_extract_ps7_init.ps1

# ModelSim 只当交叉编译器用（vsim 无授权），它的 work 库不入库
sim/msim/
sim/*.run/
ku5p/build/frozen_*/*.bit
ku5p/build/exp_*/*.bit
ku5p/build/exp_*/*.dcp

# 构建的 stdout 镜像（log 已由 vivado -log 生成，两份都是本机产物）
build/*.stdout

# 作者自用学习文档（中文文件名）。比赛指南 §3.3.3.4 要求仓库内文件名纯 ASCII，
# 所以它**不入库**；写在 .gitignore 而不是 .git/info/exclude，是为了这条排除规则本身可被审查看见、
# 换机器也不会失效（原来只在 .git/info/exclude 里 = 只存在于这台机器）。
study/
