# 构建产物快照（本地对照用，不入库：每个 .bit 约 10MB）
build/snap_*/
# 成套归档：只入库报告与 MANIFEST（md5 清单），二进制留在本地——与 ku5p/build/*.bit 同一条口径
build/frozen_*/*.bit
build/frozen_*/*.xsa
build/frozen_*/*.elf
build/failed_*/*.bit
build/failed_*/*.xsa

# KU5P 工程的 Vivado 生成目录（与 vivado_system/ 同理）
ku5p/vivado_ku5p/
ku5p/build/*.bit
clockInfo.txt

# 从 build/system.xsa 里解出来的 PS 初始化脚本（派生物，ps_jtag_boot.tcl 会自动重建）
build/ps7_init.tcl
build/_extract_ps7_init.ps1

# ModelSim 只当交叉编译器用（vsim 无授权），它的 work 库不入库
sim/msim/
sim/*.run/
